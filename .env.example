# Copy to .env (cp .env.example .env) before `docker compose up`.
# docker-compose.yml reads these via env_file + ${VAR:-default} substitution.

# --- Storage / database -----------------------------------------------------
# Consumed by the API (api.deps), the runner worker (run_ga.py), the storage
# factory (ga/storage.py: STORAGE=postgres) and scripts/migrate.py.
# Host inside the compose network is "postgres" (the service name).
DATABASE_URL=postgresql://ga:ga@postgres:5432/ga
STORAGE=postgres

# --- Postgres service credentials -------------------------------------------
# Used by the postgres container; keep these in sync with DATABASE_URL above.
POSTGRES_USER=ga
POSTGRES_PASSWORD=ga
POSTGRES_DB=ga

# --- Target LLM (provider / endpoint / model) -------------------------------
# IMPORTANT WIRING NOTE: the GA worker does NOT read these LLM_* / OLLAMA_*
# variables today. Provider, base_url and model are read from the experiment
# config (the HarnessConfig block) stored in the database -- i.e. from the JSON
# you POST to /experiments. These variables are the single documented place a
# future "env -> experiment-config defaults" wiring will read from; they are
# passed into the runner container so that wiring needs no compose change.
# For now, set provider/base_url/model in the experiment config you submit.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.2
LLM_API_KEY=not-needed
LLM_TIMEOUT_SECONDS=120

# --- Frontend dashboard -----------------------------------------------------
# VITE_API_BASE_URL is baked into the static bundle at build time (it is the
# URL the *browser* uses to reach the API, not an in-network URL). FRONTEND_PORT
# is the host port nginx serves the dashboard on.
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=3000

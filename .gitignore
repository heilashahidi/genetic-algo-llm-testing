runs/
results/
outputs/
*.sqlite
*.sqlite3
*.db
*.parquet
*.jsonl
*.npy
*.npz

# --- Datasets (large / regenerable / external) ---
data/
datasets/

# --- Generated visualization renders (committed diagrams stay tracked) ---
figures/
plots/


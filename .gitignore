# --- Repomix output (never commit the packed codebase) ---
repomix-codebase.xml
repomix-*.xml
repomix-output.*

# --- Secrets / local env ---
.env
.env.*
!.env.example

# --- Python bytecode & build artifacts ---
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Test / type / lint caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
htmlcov/

# --- Jupyter ---
.ipynb_checkpoints/

